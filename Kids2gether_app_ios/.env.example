# Copie para .env e preencha. Variáveis EXPO_PUBLIC_* são embutidas no bundle
# em tempo de build. Em builds na nuvem (EAS), o .env NÃO é enviado (gitignored):
# cadastre estas mesmas variáveis em `eas env:create` ou no dashboard do Expo.

# Firebase (projeto kids2gether-4ca94) — src/services/firebase.js
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=kids2gether-4ca94.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=kids2gether-4ca94
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=kids2gether-4ca94.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=786445331555
EXPO_PUBLIC_FIREBASE_APP_ID=

# Google Maps
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
